# DClaw Chat Environment Variables
# Copy this file to .env and fill in the values

# Deployment
# Set ENVIRONMENT=production in prod. With ENVIRONMENT=production the API
# refuses to start if DEBUG=true (DEBUG grants an unauthenticated Owner
# dev-user — an open admin backdoor). Keep DEBUG=false outside local dev.
ENVIRONMENT=development
DEBUG=false

# Database
DB_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://dclaw:${DB_PASSWORD}@db:5432/dclaw_chat

# AI Providers
OLLAMA_URL=http://localhost:11434
OPENROUTER_API_KEY=          # Required for cloud models (Kimi, Claude, GPT-4o)
OPENROUTER_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=              # Required for DeepSeek V4 via NVIDIA NIMs

# Auth (Logto)
# In production LOGTO_JWKS_URL is REQUIRED: tokens are verified (RS256) against
# this JWKS. Without it the API rejects all tokens (fail-closed) unless DEBUG=true.
LOGTO_ENDPOINT=
LOGTO_AUDIENCE=
LOGTO_ISSUER=
LOGTO_JWKS_URL=

# Rate limiting / caching
# Set REDIS_URL so rate-limit counters are shared across workers/pods (without it
# limits are per-process and reset on restart). Enable TRUST_PROXY_HEADERS only
# when behind a reverse proxy/ingress that sets X-Forwarded-For.
REDIS_URL=
TRUST_PROXY_HEADERS=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:1420
